GROQ_API_KEY=
GEMINI_API_KEY=
# (se sigue aceptando GOOGLE_API_KEY como nombre alternativo)
# Modelos (sobrescribibles)
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-flash-latest
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_PREDICT=1024
OLLAMA_THINK=false
# Orquestación
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60
LOG_LEVEL=INFO
MAX_REVISIONS=2
MAX_DRAFT_CHARS=1500
API_MODE=demo
# Orígenes permitidos por la API (coma). Para la demo desde GitHub Pages, añade tu URL:
# API_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://TU-USUARIO.github.io
